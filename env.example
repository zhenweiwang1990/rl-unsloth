# =============================================================================
# Link Search Agent GRPO Training Configuration
# =============================================================================

# HuggingFace Token (required for private datasets)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# =============================================================================
# Model Configuration
# =============================================================================
# Model to train (from HuggingFace or ModelScope)
MODEL_NAME=unsloth/Qwen3-30B-A3B-128K

# Max sequence length (affects VRAM usage)
MAX_SEQ_LENGTH=32768

# =============================================================================
# Training Configuration
# =============================================================================
# Dataset sizes
TRAIN_DATASET_SIZE=1000
EVAL_DATASET_SIZE=100

# Training hyperparameters
MAX_STEPS=200
LEARNING_RATE=1e-5
PER_DEVICE_TRAIN_BATCH_SIZE=2
GRADIENT_ACCUMULATION_STEPS=1
NUM_GENERATIONS=3
BETA=0.01

# LoRA configuration
LORA_R=16
LORA_ALPHA=16

# =============================================================================
# Agent Configuration
# =============================================================================
# Max conversation turns per query
MAX_TURNS=15

# Max tokens per model response
MAX_TOKENS=4096

# Max profiles to return in final answer
MAX_PROFILES=10

# =============================================================================
# Evaluation Configuration
# =============================================================================
# Target accuracy for early stopping
TARGET_ACCURACY=0.80

# Evaluation and save frequency
EVAL_STEPS=10
SAVE_STEPS=10

# Early stopping patience
PATIENCE=5

# =============================================================================
# Weights & Biases (optional)
# =============================================================================
WANDB_PROJECT=link-search-grpo
WANDB_ENTITY=
WANDB_NAME=
# Set to "disabled" to turn off wandb logging
WANDB_MODE=online

# =============================================================================
# Miscellaneous
# =============================================================================
# Output directory for checkpoints and logs
OUTPUT_DIR=outputs/grpo_linksearch_masked

# Random seed for reproducibility
SEED=42

# Enable verbose logging
VERBOSE=false

# Run baseline evaluation before training
RUN_BASELINE_EVAL=true

# =============================================================================
# PostgreSQL Export Configuration (for generate_database.sh)
# =============================================================================
# Uncomment and fill these to export profiles from PostgreSQL
# PG_HOST=your-postgres-host.com
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=your-password
# PG_DATABASE=your-database

# =============================================================================
# Database Path (auto-configured)
# =============================================================================
# LINK_SEARCH_DB_PATH=/workspace/link_search_agent/data/profiles.db
